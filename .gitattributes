# Everything text stays LF everywhere: CRLF would break #!/usr/bin/env bash
# shebangs, zig fmt --check, and ruff format --check.
* text=auto eol=lf

*.png binary
# Vendored Ubuntu arm64 debs: git's text=auto heuristic can mis-tag a
# binary ar archive that happens not to contain a NUL in the first 8 KiB,
# and a CRLF conversion would invalidate SHA256SUMS.
*.deb binary
