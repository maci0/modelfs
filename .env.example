# modelfs environment configuration template
# Copy to .env or export in the deployment environment before starting modelfs.
# Note: modelfs rejects any unknown MODELFS_* environment variables as typos.

# Shared storage origin directory (NFS export). Required for mount, peers, verify, dupes, pull.
MODELFS_ORIGIN=/net/192.168.0.100/models

# Local NVMe piece cache directory (default: /var/cache/modelfs).
MODELFS_CACHE=/var/cache/modelfs

# Cluster authentication pre-shared key (PSK).
# Provide either MODELFS_PSK (path to 0600 file) OR MODELFS_PSK_VALUE (inline secret string).
# These two options are mutually exclusive on mount.
MODELFS_PSK=/etc/modelfs.psk
# MODELFS_PSK_VALUE=replace_with_cluster_secret_hex

# Node identifier in the cluster lease (default: short hostname).
# Mount command only. Must be printable ASCII without '/', '\', '"', or leading dot.
# MODELFS_ID=spark-node-01

# Logging ceiling: err, warn, info (default), debug.
MODELFS_LOG=info

# Hugging Face access token for modelfs pull (only needed for private repositories).
# Never passed as a CLI flag because /proc/<pid>/cmdline is world-readable.
# HF_TOKEN=hf_replace_with_your_access_token

# Hugging Face cache root directory override (default: ~/.cache/huggingface).
# HF_HOME=/home/maci/.cache/huggingface
