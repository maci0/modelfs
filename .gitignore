# Zig
zig-out/
.zig-cache/

# Python
__pycache__/
.venv/
.mypy_cache/
.ruff_cache/

# Vendored/downloaded dependencies: the arm64 libfuse3 provenance (.deb
# files + SHA256SUMS + README) ships so the documented aarch64 cross-build
# works from a fresh clone. Extraction writes under .scratch/fuse3-arm64/
# (see .deps/fuse3-arm64/README.md). Keep ignoring the old in-tree root/
# and lib/ plus ar-fallback members so a leftover extract cannot be
# committed.
.deps/*
!.deps/fuse3-arm64/
.deps/fuse3-arm64/root/
.deps/fuse3-arm64/lib/
.deps/fuse3-arm64/data.tar.zst
.deps/fuse3-arm64/control.tar.zst
.deps/fuse3-arm64/debian-binary
!.deps/libfuse3-3.16.2/
# No extraction subdirs here: the vendored tree IS the source, all of it
# (README, SHA256SUMS, include/, lib/, licenses) ships tracked.

# Crash artifacts: a core dump from a failed zig test or daemon run lands in
# the crashing process's cwd, usually the repo root, and must never reach the
# index again (a 4 MB vgcore.<pid> was committed once).
core
core.*
vgcore.*
*.core

# Scratch and runtime state
.scratch/
.gauntlet.lock
