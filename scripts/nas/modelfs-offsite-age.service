[Unit]
Description=Alarm if the ModelFS offsite copy is older than the claimed site-loss RPO
Documentation=file:///usr/local/share/doc/modelfs/recovery.md
OnFailure=notify-admin@%n.service
After=zfs-import.target
Requires=zfs-import.target
# Weekly, not the monthly clone: a stopped disk rotation or hosted pull
# never fails sanoid.service. Enable this timer only on a box that always
# holds the copy (hosted ZFS). A rotated disk that is not always imported
# should run modelfs-check-offsite by hand when the disk is attached.
# Leave MF_OFFSITE_DATASET unset here and the unit fails closed: checking
# the live tank/models on the NAS would bless production as the offsite copy.
# Requires=zfs-import.target matches the other ZFS units: a failed pool
# import must not still start a oneshot that can only fail.

[Service]
Type=oneshot
# Read-only zfs list. Keep /dev visible (/dev/zfs); do not set
# PrivateDevices=yes. Set MF_OFFSITE_DATASET with `systemctl edit`
# (a drop-in); --full is overwritten by --install. Leave it unset
# here so a live-NAS default cannot bless production as the offsite copy.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# Environment=MF_OFFSITE_DATASET=tank/models
ExecStart=/usr/local/sbin/modelfs-check-offsite
