[Unit]
Description=Pull tank/models from the NAS onto this replica host
Documentation=file:///usr/local/share/doc/modelfs/recovery.md
OnFailure=notify-admin@%n.service
After=zfs-import.target network-online.target
Requires=zfs-import.target
Wants=network-online.target
# Pull, not push: this unit runs on the replica host so NAS root cannot
# destroy the pool-loss copy with the same credential that can destroy
# tank/models. Override MF_SYNCOID_SRC with `systemctl edit` (a drop-in)
# after a dedicated replica-user key can zfs send from the NAS. Do not
# use `systemctl edit --full`: that replaces this file, and the next
# install_nas_backup.sh --install would restore the placeholder.

[Service]
Type=oneshot
# Initial pull and a large incremental are hours, not the 90 s some
# systemd defaults give Type=oneshot. infinity is explicit so a Rocky
# host whose DefaultTimeoutStartSec is still 90 s cannot kill the recv.
TimeoutStartSec=infinity
# Sandbox, minus the one knob this unit genuinely needs. ProtectHome=yes
# is deliberately absent: the SSH key lives in /root/.ssh, and setting it
# would fail the pull closed. Everything else applies: syncoid streams
# through the zfs ioctl (no filesystem writes) and hold_monthlies.sh only
# runs zfs commands, so ProtectSystem=strict costs nothing, PrivateTmp=yes
# keeps scratch off a shared /tmp, and NoNewPrivileges=yes stops the ssh
# and zfs helpers from gaining anything. /dev stays visible for /dev/zfs.
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
Environment=MF_SYNCOID_SRC=nas:tank/models
Environment=MF_SYNCOID_DEST=tank/models
# BatchMode: fail the unit on a missing host key or a password prompt
# instead of hanging until TimeoutStartSec=infinity. ConnectTimeout
# bounds a blackholed NAS so the daily timer can fire OnFailure.
# --recursive matches sanoid.conf recursive = yes: a later
# `zfs create tank/models/gguf` is snapshotted and must also land
# on the replica, or pool-loss restore silently drops the new dataset.
ExecStart=/usr/bin/syncoid --recursive --no-privilege-elevation --sshoption=BatchMode=yes --sshoption=ConnectTimeout=30 ${MF_SYNCOID_SRC} ${MF_SYNCOID_DEST}
# Monthlies survive a recursive destroy only until `zfs release`.
# Already-held is success; any other hold failure fails this unit
# (scripts/hold_monthlies.sh). The previous `|| true` swallowed a
# missing hold as a green pull.
ExecStartPost=/usr/local/sbin/modelfs-hold-monthlies ${MF_SYNCOID_DEST}

