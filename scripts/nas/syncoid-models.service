[Unit]
Description=Pull tank/models from the NAS onto this replica host
Documentation=file:///usr/local/share/doc/modelfs/recovery.md
OnFailure=notify-admin@%n.service
After=zfs-import.target
# Pull, not push: this unit runs on the replica host so NAS root cannot
# destroy the pool-loss copy with the same credential that can destroy
# tank/models. Replace nas:tank/models with the SSH target after a
# dedicated replica-user key can zfs send from the NAS.

[Service]
Type=oneshot
ExecStart=/usr/bin/syncoid --no-privilege-elevation nas:tank/models tank/models
# Monthlies survive a recursive destroy only until `zfs release`. An
# already-held snapshot makes `zfs hold` fail; that is success here.
ExecStartPost=/bin/bash -c 'for s in $(zfs list -H -t snapshot -o name tank/models | grep "_monthly$" || true); do zfs hold modelfs-dr "$s" || true; done'
